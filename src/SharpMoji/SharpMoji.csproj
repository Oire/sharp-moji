<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Oire.SharpMoji</RootNamespace>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- The library ships no reflection-based serialization: all JSON goes through a
         source-generated JsonSerializerContext, so it is safe to trim and to publish AOT.
         See docs/SPEC.md section 2. -->
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageId>Oire.SharpMoji</PackageId>
    <Authors>André Polykanine; Oire</Authors>
    <Company>Oire Software</Company>
    <Product>SharpMoji</Product>
    <Description>A cross-platform .NET library for emoji data: lookup, localized search, skin-tone variants and canonical ordering. All emoji data is embedded — no network access and no file I/O.</Description>
    <Copyright>Copyright © 2026 André Polykanine, Oire Software</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageProjectUrl>https://github.com/Oire/sharp-moji</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Oire/sharp-moji</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>emoji;unicode;emojibase;cldr;search;localization;skin-tone;accessibility</PackageTags>
    <!-- The package embeds all 28 languages (about 1.4 MB). That is deliberate: see the comment on
         the EmbeddedResource item below. -->
    <!-- No <Version> here: GitVersion.MsBuild derives it from git tags (see GitVersion.yml, ManualDeployment
         mode). A release is cut by pushing a `v*` tag; untagged builds get a pre-release version. -->
    <PackageReleaseNotes>https://github.com/Oire/sharp-moji/blob/master/CHANGELOG.md</PackageReleaseNotes>

    <!-- Reproducible build + source debugging. SourceLink is bundled in the .NET SDK, so no explicit
         package reference is needed; the properties below turn it on. -->
    <Deterministic>true</Deterministic>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <!-- SourceLink resolves source-file URLs from the git remote. Off CI the remote may be an SSH host
         alias (e.g. "github:") that SourceLink's GitHub provider doesn't recognize, so it can't build the
         link and emits a benign "source control information is not available" warning — which
         TreatWarningsAsErrors would turn into a build failure. SourceLink only matters for the published
         package (built in CI with a github.com remote and full history), so turn it off off CI. -->
    <EnableSourceLink Condition="'$(GITHUB_ACTIONS)' != 'true'">false</EnableSourceLink>
  </PropertyGroup>

  <ItemGroup>
    <!-- The emoji data itself. Generated by tools/SharpMoji.DataTool and committed, so building
         from source needs neither the corpus nor a network connection. Regenerate with
         scripts/update-emoji-data.ps1 - never edit by hand.

         Resource names are left to the SDK's default convention (RootNamespace + folder + file),
         which differs between the core and satellite assemblies. EmbeddedPackReader therefore
         matches on the trailing file name rather than a fixed prefix. Setting LogicalName here
         instead is a trap: with a wildcard it does not batch per item, every file collapses onto
         one name, and all but one silently vanish from the assembly.

         WithCulture="false" is essential and not optional. MSBuild's AssignCulture task reads the
         middle segment of a "name.xx.ext" file as a culture tag, so strings.de.br looks exactly
         like a German localization resource. Without this, every locale pack is compiled into a
         per-culture satellite resource assembly (bin/de/, bin/uk/, ...) and disappears from the
         main assembly entirely - leaving only structure.br, which has no culture-shaped name. -->
    <EmbeddedResource Include="Resources/*.br" WithCulture="false" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="\" />
    <None Include="../../icon.png" Pack="true" PackagePath="\" />
    <!-- The package embeds CLDR-derived emoji data, so the third-party attributions must travel with
         it. See docs/SPEC.md section 11. -->
    <None Include="../../NOTICE" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SharpMoji.Tests" />
    <!-- The data tool writes the embedded pack format the library owns, so it needs the same
         internal DTOs and serializer. Build-time only; it ships nothing. -->
    <InternalsVisibleTo Include="SharpMoji.DataTool" />
    <!-- Temporary, until Phase 2 gives the sample a public catalog API to call. The sample is the
         trim and NativeAOT smoke test, and it can only prove the packs load if it can load one. -->
    <InternalsVisibleTo Include="SharpMoji.Samples.Console" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
    <PackageReference Include="Roslynator.Analyzers" Version="5.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="GitVersion.MsBuild" Version="6.8.2">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="5.9.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="10.0.401" PrivateAssets="all" />
  </ItemGroup>

</Project>
